# PostgreSQL
POSTGRES_DB=flygio
POSTGRES_USER=flygio
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Connection string for the app (used by docker-compose.prod.yml)
DATABASE_URL=Host=postgres;Port=5432;Database=flygio;Username=flygio;Password=CHANGE_ME_STRONG_PASSWORD

# Amadeus Self-Service API (https://developers.amadeus.com)
AMADEUS_CLIENT_ID=YOUR_AMADEUS_API_KEY
AMADEUS_CLIENT_SECRET=YOUR_AMADEUS_API_SECRET

# Travelpayouts Affiliate (https://travelpayouts.com)
TRAVELPAYOUTS_MARKER_ID=503994

# Umami Analytics (self-hosted, set after deploying Umami on Coolify)
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
UMAMI_APP_SECRET=CHANGE_ME_RANDOM_SECRET
UMAMI_DB_USER=umami
UMAMI_DB_PASSWORD=CHANGE_ME_UMAMI_PASSWORD
UMAMI_DB_NAME=umami
