# PostgreSQL
POSTGRES_DB=flygio
POSTGRES_USER=flygio
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Connection string for the app (used by docker-compose.prod.yml)
DATABASE_URL=Host=postgres;Port=5432;Database=flygio;Username=flygio;Password=CHANGE_ME_STRONG_PASSWORD

# Travelpayouts (https://travelpayouts.com)
TRAVELPAYOUTS_MARKER_ID=503994
TRAVELPAYOUTS_API_TOKEN=YOUR_TRAVELPAYOUTS_API_TOKEN

# Umami Analytics (self-hosted, set after deploying Umami on Coolify)
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
UMAMI_APP_SECRET=CHANGE_ME_RANDOM_SECRET
UMAMI_DB_USER=umami
UMAMI_DB_PASSWORD=CHANGE_ME_UMAMI_PASSWORD
UMAMI_DB_NAME=umami

# Resend Email API (https://resend.com) - Free tier: 3,000 emails/month
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=noreply@flygio.se
RESEND_FROM_NAME=Flygio

# Sentry Error Monitoring (https://sentry.io)
SENTRY_DSN=
