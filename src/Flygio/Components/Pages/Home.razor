@page "/"
@using Flygio.Data
@using Flygio.Data.Models
@using Flygio.Services
@using Microsoft.Extensions.Options
@inject FlygioDbContext Db
@inject IJSRuntime JS
@inject IOptions<TravelpayoutsSettings> TpSettings

<PageTitle>Flygio - Sök flyg från Sverige</PageTitle>
<HeadContent>
    <meta name="description" content="Sök flygpriser från Sverige. Flygio jämför priser via Aviasales och länkar till resebyråer. Prisbevakning och flygrutter." />
    <meta property="og:title" content="Flygio - Sök flyg från Sverige" />
    <meta property="og:description" content="Sök flygpriser från Sverige. Flygio jämför priser och länkar till resebyråer som Aviasales och Kiwi.com." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://flygio.se/" />
    <meta property="og:image" content="https://flygio.se/og-image/default" />
    <meta name="twitter:title" content="Flygio - Sök flyg från Sverige" />
    <meta name="twitter:description" content="Sök flygpriser från Sverige. Jämför priser och boka via resebyråer." />
    <meta name="twitter:image" content="https://flygio.se/og-image/default" />
    <link rel="canonical" href="https://flygio.se/" />
</HeadContent>

<section class="hero-search">
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <h1>Sök flyg från Sverige</h1>
        <p>Vi jämför flygpriser och länkar till resebyråer för bokning</p>
    </div>

    <div class="search-widget-container">
        <div id="aviasales-widget"></div>
    </div>
</section>

<section class="why-flygio">
    <h2>Så funkar Flygio</h2>
    <div class="why-grid">
        <div class="why-card">
            <div class="why-icon">
                <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" stroke-linecap="round"/></svg>
            </div>
            <h3>Vi jämför priser</h3>
            <p>Sök bland hundratals flygbolag och resebyråer. Resultaten visar riktiga priser med direktlänkar till bokning.</p>
        </div>
        <div class="why-card">
            <div class="why-icon">
                <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 01-3.46 0" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <h3>Prisbevakning</h3>
            <p>Sätt ett målpris så meddelar vi dig om priset sjunker. Vi kollar automatiskt, men garanterar inte att vi fångar alla ändringar.</p>
        </div>
        <div class="why-card">
            <div class="why-icon">
                <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <h3>Affiliatelänkar</h3>
            <p>När du klickar "Boka" skickas du till en resebyrå som Aviasales eller Kiwi.com. Vi får en liten ersättning — det kostar dig inget extra.</p>
        </div>
        <div class="why-card">
            <div class="why-icon">
                <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <h3>Vi är inte störst</h3>
            <p>Skyscanner och Google Flights har fler resultat. Vi är en liten sajt som fokuserar på Sverige och försöker vara rakt på sak.</p>
        </div>
    </div>
</section>

<section class="popular-destinations">
    <h2>Populära destinationer från Sverige</h2>
    <div class="dest-grid">
        @foreach (var dest in PopularDestinations)
        {
            <a href="/flyg-till/@dest.Slug" class="dest-card" style="background-image: url('https://source.unsplash.com/400x300/?@(dest.Slug),travel')">
                <div class="dest-card-overlay">
                    <span class="dest-card-name">@dest.City</span>
                </div>
            </a>
        }
    </div>
    <div class="dest-more">
        <a href="/flyg-till">Se alla destinationer &rarr;</a>
    </div>
</section>

@code {
    private record DestLink(string City, string Slug);

    private static readonly DestLink[] PopularDestinations =
    [
        new("Barcelona", "barcelona"), new("London", "london"), new("Bangkok", "bangkok"),
        new("Málaga", "malaga"), new("Aten", "aten"), new("Palma de Mallorca", "palma-de-mallorca"),
        new("Paris", "paris"), new("Rom", "rom"), new("Amsterdam", "amsterdam"),
        new("Istanbul", "istanbul"), new("Alicante", "alicante"), new("Berlin", "berlin"),
        new("Prag", "prag"), new("Budapest", "budapest"), new("New York", "new-york"),
    ];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var markerId = TpSettings.Value.MarkerId;
            await JS.InvokeVoidAsync("flygio.initAviasalesWidget", markerId);
        }
    }
}
