@page "/hyrbil"
@using Flygio.Data
@using Flygio.Data.Models
@using Flygio.Services
@using Microsoft.EntityFrameworkCore
@inject FlygioDbContext Db
@inject TravelpayoutsAffiliateLinkService AffiliateService

<PageTitle>Hyr bil billigt i populara resmal - Flygio</PageTitle>
<HeadContent>
    <meta name="description" content="Jamfor priser pa hyrbil i populara destinationer. Hitta billig hyrbil i Barcelona, London, Bangkok, Paris och fler stader." />
    <meta property="og:title" content="Hyr bil billigt i populara resmal - Flygio" />
    <meta property="og:description" content="Jamfor priser pa hyrbil i populara destinationer. Hitta billig hyrbil i Barcelona, London, Bangkok och fler." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://flygio.se/hyrbil" />
    <link rel="canonical" href="https://flygio.se/hyrbil" />
</HeadContent>

<section class="max-w-5xl mx-auto px-4 py-8">
    <div class="text-center mb-10">
        <h1 class="text-4xl font-bold text-gray-900 mb-3">Hyr bil i populara resmal</h1>
        <p class="text-lg text-gray-600">Jamfor priser pa hyrbil och hitta basta erbjudandena i varldens mest populara stader</p>
    </div>

    <div class="bg-gradient-to-r from-emerald-50 to-teal-50 rounded-xl p-6 mb-10 border border-emerald-200">
        <h2 class="text-lg font-semibold text-gray-800 mb-4">Sok hyrbil direkt</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Destination</label>
                <input type="text" @bind="searchCity" placeholder="T.ex. Barcelona"
                       class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" />
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Hamta</label>
                <input type="date" @bind="pickUp"
                       class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" />
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Lamna</label>
                <input type="date" @bind="dropOff"
                       class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" />
            </div>
        </div>
        <div class="mt-4 flex gap-3">
            <a href="@GetSearchUrl("rentalcars")" target="_blank" rel="noopener sponsored"
               class="inline-flex items-center bg-emerald-600 text-white px-6 py-3 rounded-lg hover:bg-emerald-700 transition-colors font-medium">
                Sok pa Rentalcars &rarr;
            </a>
            <a href="@GetSearchUrl("economybookings")" target="_blank" rel="noopener sponsored"
               class="inline-flex items-center bg-teal-600 text-white px-6 py-3 rounded-lg hover:bg-teal-700 transition-colors font-medium">
                Sok pa Economybookings &rarr;
            </a>
        </div>
    </div>

    @if (destinations is null)
    {
        <div class="text-center py-16">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-emerald-600 mx-auto mb-4"></div>
            <p class="text-gray-600">Laddar destinationer...</p>
        </div>
    }
    else if (!destinations.Any())
    {
        <p class="text-center text-gray-600">Inga destinationer annu.</p>
    }
    else
    {
        @foreach (var group in destinations.GroupBy(d => d.Country).OrderBy(g => g.Key))
        {
            <div class="mb-8">
                <h2 class="text-2xl font-semibold text-gray-800 mb-4">Hyrbil i @group.Key</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                    @foreach (var dest in group.OrderBy(d => d.City))
                    {
                        <a href="/hyrbil/@dest.Slug" class="group bg-white border border-gray-200 rounded-xl p-5 hover:shadow-lg hover:border-emerald-300 transition-all">
                            <h3 class="text-lg font-semibold text-gray-800 group-hover:text-emerald-600 transition-colors">
                                Hyrbil i @dest.City
                            </h3>
                            <p class="text-sm text-gray-500 mt-1">@dest.Country</p>
                            <span class="text-sm text-emerald-600 mt-2 inline-block group-hover:underline">Jamfor priser &rarr;</span>
                        </a>
                    }
                </div>
            </div>
        }
    }

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-8">
        <div class="bg-blue-50 rounded-xl p-8 text-center">
            <h2 class="text-xl font-semibold text-gray-800 mb-3">Behover du flyg?</h2>
            <p class="text-gray-600 mb-4">Jamfor flygpriser fran Sverige till hundratals destinationer.</p>
            <a href="/flyg-till" class="inline-block bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors font-medium">
                Se alla flygdestinationer &rarr;
            </a>
        </div>
        <div class="bg-amber-50 rounded-xl p-8 text-center">
            <h2 class="text-xl font-semibold text-gray-800 mb-3">Behover du hotell?</h2>
            <p class="text-gray-600 mb-4">Hitta billigt boende i populara destinationer.</p>
            <a href="/hotell" class="inline-block bg-amber-600 text-white px-6 py-3 rounded-lg hover:bg-amber-700 transition-colors font-medium">
                Se alla hotelldestinationer &rarr;
            </a>
        </div>
    </div>
</section>

@code {
    private List<Destination>? destinations;
    private string searchCity = "";
    private DateTime pickUp = DateTime.Today.AddDays(14);
    private DateTime dropOff = DateTime.Today.AddDays(21);

    protected override async Task OnInitializedAsync()
    {
        destinations = await Db.Destinations
            .Where(d => d.IsPublished)
            .OrderBy(d => d.City)
            .ToListAsync();
    }

    private string GetSearchUrl(string provider)
    {
        var city = string.IsNullOrWhiteSpace(searchCity) ? "Stockholm" : searchCity;
        return AffiliateService.GetCarRentalRedirectUrl(provider, city, pickUp, dropOff);
    }
}
