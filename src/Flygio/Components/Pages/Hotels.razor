@page "/hotell"
@using Flygio.Data
@using Flygio.Data.Models
@using Flygio.Services
@using Microsoft.EntityFrameworkCore
@inject FlygioDbContext Db
@inject TravelpayoutsAffiliateLinkService AffiliateService

<PageTitle>Hitta billiga hotell i populära resmål – Flygio</PageTitle>
<HeadContent>
    <meta name="description" content="Jämför hotellpriser i populära destinationer. Hitta billigt boende i Barcelona, London, Bangkok, Paris och fler städer." />
    <meta property="og:title" content="Hitta billiga hotell i populära resmål – Flygio" />
    <meta property="og:description" content="Jämför hotellpriser i populära destinationer. Hitta billigt boende i Barcelona, London, Bangkok och fler." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://flygio.se/hotell" />
    <link rel="canonical" href="https://flygio.se/hotell" />
</HeadContent>

<section class="max-w-5xl mx-auto px-4 py-8">
    <div class="text-center mb-10">
        <h1 class="text-4xl font-bold text-gray-900 mb-3">Hitta hotell i populära resmål</h1>
        <p class="text-lg text-gray-600">Jämför hotellpriser och boka billigt boende i världens mest populära städer</p>
    </div>

    <div class="bg-gradient-to-r from-amber-50 to-orange-50 rounded-xl p-6 mb-10 border border-amber-200">
        <h2 class="text-lg font-semibold text-gray-800 mb-4">Sök hotell direkt</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Destination</label>
                <input type="text" @bind="searchCity" placeholder="T.ex. Barcelona"
                       class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500" />
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Incheckning</label>
                <input type="date" @bind="checkIn"
                       class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500" />
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Utcheckning</label>
                <input type="date" @bind="checkOut"
                       class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500" />
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Gäster</label>
                <select @bind="guests"
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500">
                    <option value="1">1 gäst</option>
                    <option value="2">2 gäster</option>
                    <option value="3">3 gäster</option>
                    <option value="4">4 gäster</option>
                </select>
            </div>
        </div>
        <div class="mt-4">
            <a href="@GetSearchUrl()" target="_blank" rel="noopener sponsored"
               class="inline-flex items-center bg-amber-600 text-white px-6 py-3 rounded-lg hover:bg-amber-700 transition-colors font-medium">
                Sök hotell &rarr;
            </a>
        </div>
    </div>

    @if (destinations is null)
    {
        <div class="text-center py-16">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-amber-600 mx-auto mb-4"></div>
            <p class="text-gray-600">Laddar destinationer...</p>
        </div>
    }
    else if (!destinations.Any())
    {
        <p class="text-center text-gray-600">Inga destinationer ännu.</p>
    }
    else
    {
        @foreach (var group in destinations.GroupBy(d => d.Country).OrderBy(g => g.Key))
        {
            <div class="mb-8">
                <h2 class="text-2xl font-semibold text-gray-800 mb-4">Hotell i @group.Key</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                    @foreach (var dest in group.OrderBy(d => d.City))
                    {
                        <a href="/hotell/@dest.Slug" class="group bg-white border border-gray-200 rounded-xl p-5 hover:shadow-lg hover:border-amber-300 transition-all">
                            <h3 class="text-lg font-semibold text-gray-800 group-hover:text-amber-600 transition-colors">
                                Hotell i @dest.City
                            </h3>
                            <p class="text-sm text-gray-500 mt-1">@dest.Country</p>
                            <span class="text-sm text-amber-600 mt-2 inline-block group-hover:underline">Hitta hotell &rarr;</span>
                        </a>
                    }
                </div>
            </div>
        }
    }

    <div class="text-center mt-8 bg-amber-50 rounded-xl p-8">
        <h2 class="text-xl font-semibold text-gray-800 mb-3">Letar du efter flyg också?</h2>
        <p class="text-gray-600 mb-4">Jämför flygpriser från Sverige till hundratals destinationer.</p>
        <a href="/flyg-till" class="inline-block bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors font-medium">
            Se alla flygdestinationer &rarr;
        </a>
    </div>
</section>

@code {
    private List<Destination>? destinations;
    private string searchCity = "";
    private DateTime checkIn = DateTime.Today.AddDays(14);
    private DateTime checkOut = DateTime.Today.AddDays(17);
    private int guests = 2;

    protected override async Task OnInitializedAsync()
    {
        destinations = await Db.Destinations
            .Where(d => d.IsPublished)
            .OrderBy(d => d.City)
            .ToListAsync();
    }

    private string GetSearchUrl()
    {
        var city = string.IsNullOrWhiteSpace(searchCity) ? "Stockholm" : searchCity;
        return AffiliateService.GetHotelRedirectUrl(city, checkIn, checkOut, guests);
    }
}
