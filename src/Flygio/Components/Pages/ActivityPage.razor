@page "/aktiviteter/{Slug}"
@rendermode InteractiveServer
@using Flygio.Data
@using Flygio.Data.Models
@using Flygio.Services
@using Microsoft.EntityFrameworkCore
@inject FlygioDbContext Db
@inject TravelpayoutsAffiliateLinkService AffiliateService
@inject NavigationManager Nav

@if (destination is not null)
{
    <PageTitle>Aktiviteter i @destination.City - Turer och upplevelser | Flygio</PageTitle>
    <HeadContent>
        <meta name="description" content="Hitta turer, upplevelser och aktiviteter i @destination.City, @destination.Country. Boka guidade turer och saker att gora." />
        <meta property="og:title" content="Aktiviteter i @destination.City - Turer och upplevelser | Flygio" />
        <meta property="og:description" content="Hitta turer, upplevelser och aktiviteter i @destination.City, @destination.Country." />
        <meta property="og:type" content="website" />
        <meta property="og:url" content="https://flygio.se/aktiviteter/@destination.Slug" />
        <link rel="canonical" href="https://flygio.se/aktiviteter/@destination.Slug" />
        <script type="application/ld+json">
        {
            "@@context": "https://schema.org",
            "@@type": "FAQPage",
            "mainEntity": [
                {
                    "@@type": "Question",
                    "name": "Vad kan man gora i @destination.City?",
                    "acceptedAnswer": {
                        "@@type": "Answer",
                        "text": "I @destination.City finns massor av turer, upplevelser och aktiviteter att valja pa. Jamfor utbudet via Flygio for att hitta de basta erbjudandena."
                    }
                },
                {
                    "@@type": "Question",
                    "name": "Var hittar jag guidade turer i @destination.City?",
                    "acceptedAnswer": {
                        "@@type": "Answer",
                        "text": "Via Flygio kan du jamfora turer och aktiviteter i @destination.City fran GetYourGuide och Viator for att hitta basta pris och utbud."
                    }
                }
            ]
        }
        </script>
    </HeadContent>
}

<section class="max-w-4xl mx-auto px-4 py-8">
    @if (destination is null)
    {
        @if (notFound)
        {
            <div class="text-center py-16">
                <h1 class="text-3xl font-bold text-gray-800 mb-4">Destinationen hittades inte</h1>
                <p class="text-gray-600 mb-6">Sidan du letar efter finns inte.</p>
                <a href="/aktiviteter" class="inline-block bg-purple-600 text-white px-6 py-3 rounded-lg hover:bg-purple-700 transition-colors">Alla aktivitetsdestinationer</a>
            </div>
        }
        else
        {
            <div class="text-center py-16">
                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-purple-600 mx-auto mb-4"></div>
                <p class="text-gray-600">Laddar destination...</p>
            </div>
        }
    }
    else
    {
        <nav class="text-sm text-gray-500 mb-6">
            <a href="/" class="hover:text-blue-600">Hem</a> &rsaquo;
            <a href="/aktiviteter" class="hover:text-purple-600">Aktiviteter</a> &rsaquo;
            <span class="text-gray-800">Aktiviteter i @destination.City</span>
        </nav>

        <h1 class="text-4xl font-bold text-gray-900 mb-2">Aktiviteter i @destination.City</h1>
        <p class="text-lg text-gray-500 mb-8">@destination.Country &middot; Turer, upplevelser och saker att gora</p>

        <div class="bg-gradient-to-r from-purple-50 to-violet-50 rounded-xl p-6 mb-8 border border-purple-200">
            <h2 class="text-lg font-semibold text-gray-800 mb-4">Hitta aktiviteter i @destination.City</h2>
            <p class="text-gray-600 mb-4">Jamfor turer och upplevelser fran tva av varldens storsta bokningsplattformar.</p>
            <div class="flex flex-wrap gap-3">
                <a href="@AffiliateService.GetActivityRedirectUrl("getyourguide", destination.City)"
                   target="_blank" rel="noopener sponsored"
                   class="inline-flex items-center bg-purple-600 text-white px-6 py-3 rounded-lg hover:bg-purple-700 transition-colors font-medium">
                    Sok pa GetYourGuide &rarr;
                </a>
                <a href="@AffiliateService.GetActivityRedirectUrl("viator", destination.City)"
                   target="_blank" rel="noopener sponsored"
                   class="inline-flex items-center bg-violet-600 text-white px-6 py-3 rounded-lg hover:bg-violet-700 transition-colors font-medium">
                    Sok pa Viator &rarr;
                </a>
            </div>
        </div>

        <div class="bg-white border border-gray-200 rounded-xl p-6 mb-8">
            <h2 class="text-xl font-semibold text-gray-800 mb-4">Tips for aktiviteter i @destination.City</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="flex gap-3">
                    <span class="text-2xl">&#127915;</span>
                    <div>
                        <h3 class="font-medium text-gray-800">Boka populara turer tidigt</h3>
                        <p class="text-sm text-gray-600">De mest populara turerna och upplevelserna saljer ofta slut snabbt, sarskilt under hogsasong.</p>
                    </div>
                </div>
                <div class="flex gap-3">
                    <span class="text-2xl">&#128200;</span>
                    <div>
                        <h3 class="font-medium text-gray-800">Jamfor plattformar</h3>
                        <p class="text-sm text-gray-600">Samma tur kan ha olika priser pa GetYourGuide och Viator. Jamfor alltid innan du bokar.</p>
                    </div>
                </div>
                <div class="flex gap-3">
                    <span class="text-2xl">&#11088;</span>
                    <div>
                        <h3 class="font-medium text-gray-800">Las recensioner</h3>
                        <p class="text-sm text-gray-600">Kolla betyg och recensioner fran andra resenarer for att hitta de basta upplevelserna.</p>
                    </div>
                </div>
                <div class="flex gap-3">
                    <span class="text-2xl">&#128176;</span>
                    <div>
                        <h3 class="font-medium text-gray-800">Gratis avbokning</h3>
                        <p class="text-sm text-gray-600">Manga turer erbjuder gratis avbokning upp till 24 timmar fore. Boka tryggt i forvag.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
            <div class="bg-blue-50 border border-blue-200 rounded-xl p-6">
                <h2 class="text-lg font-semibold text-gray-800 mb-3">Flyg till @destination.City</h2>
                <p class="text-gray-600 mb-4">Jamfor flygpriser fran Sverige.</p>
                <a href="/flyg-till/@destination.Slug"
                   class="inline-flex items-center bg-blue-600 text-white px-5 py-2.5 rounded-lg hover:bg-blue-700 transition-colors font-medium">
                    Se flygpriser &rarr;
                </a>
            </div>
            <div class="bg-amber-50 border border-amber-200 rounded-xl p-6">
                <h2 class="text-lg font-semibold text-gray-800 mb-3">Hotell i @destination.City</h2>
                <p class="text-gray-600 mb-4">Jamfor hotellpriser.</p>
                <a href="/hotell/@destination.Slug"
                   class="inline-flex items-center bg-amber-600 text-white px-5 py-2.5 rounded-lg hover:bg-amber-700 transition-colors font-medium">
                    Hitta hotell &rarr;
                </a>
            </div>
            <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-6">
                <h2 class="text-lg font-semibold text-gray-800 mb-3">Hyrbil i @destination.City</h2>
                <p class="text-gray-600 mb-4">Jamfor hyrbilspriser.</p>
                <a href="/hyrbil/@destination.Slug"
                   class="inline-flex items-center bg-emerald-600 text-white px-5 py-2.5 rounded-lg hover:bg-emerald-700 transition-colors font-medium">
                    Hitta hyrbil &rarr;
                </a>
            </div>
        </div>

        @if (relatedDestinations.Count > 0)
        {
            <div class="border-t border-gray-200 pt-8 mb-8">
                <h2 class="text-xl font-semibold text-gray-800 mb-4">Aktiviteter i andra populara stader</h2>
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
                    @foreach (var rd in relatedDestinations)
                    {
                        <a href="/aktiviteter/@rd.Slug" class="bg-white border border-gray-200 rounded-lg p-3 hover:shadow-md hover:border-purple-300 transition-all text-center">
                            <p class="font-medium text-gray-800">@rd.City</p>
                            <p class="text-xs text-gray-500">@rd.Country</p>
                        </a>
                    }
                </div>
            </div>
        }

        <div class="flex flex-wrap gap-4">
            <a href="/aktiviteter" class="text-purple-600 hover:underline">&larr; Alla aktivitetsdestinationer</a>
            <a href="/flyg-till/@destination.Slug" class="text-blue-600 hover:underline">Flyg till @destination.City</a>
            <a href="/hotell/@destination.Slug" class="text-amber-600 hover:underline">Hotell i @destination.City</a>
            <a href="/hyrbil/@destination.Slug" class="text-emerald-600 hover:underline">Hyrbil i @destination.City</a>
        </div>
    }
</section>

@code {
    [Parameter]
    public string Slug { get; set; } = "";

    private Destination? destination;
    private bool notFound;
    private List<Destination> relatedDestinations = [];

    protected override async Task OnInitializedAsync()
    {
        destination = await Db.Destinations
            .FirstOrDefaultAsync(d => d.Slug == Slug && d.IsPublished);

        if (destination is null)
        {
            notFound = true;
            return;
        }

        relatedDestinations = await Db.Destinations
            .Where(d => d.IsPublished && d.Id != destination.Id)
            .OrderBy(d => d.City)
            .Take(8)
            .ToListAsync();
    }
}
