@page "/Error"
@using System.Diagnostics

<PageTitle>Fel - Flygio</PageTitle>

<h1 class="text-danger">Ett fel uppstod.</h1>
<h2 class="text-danger">Något gick fel när din förfrågan behandlades.</h2>

@if (ShowRequestId)
{
    <p>
        <strong>Förfrågnings-ID:</strong> <code>@RequestId</code>
    </p>
}

<h3>Utvecklingsläge</h3>
<p>
    Byt till <strong>Development</strong>-miljön för att visa mer detaljerad information om felet.
</p>
<p>
    <strong>Development-miljön ska inte vara aktiverad i produktionsmiljöer.</strong>
    Det kan leda till att känslig information visas för slutanvändare.
    För lokal felsökning, aktivera <strong>Development</strong>-miljön genom att sätta <strong>ASPNETCORE_ENVIRONMENT</strong> till <strong>Development</strong>
    och starta om appen.
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
