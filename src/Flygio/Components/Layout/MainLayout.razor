@inherits LayoutComponentBase

<div class="site">
    <header class="site-header">
        <div class="header-inner">
            <a href="/" class="site-brand">
                <svg class="brand-logo" viewBox="0 0 32 32" width="28" height="28" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="16" cy="16" r="15" fill="url(#brandGrad)" />
                    <path d="M10 20l6-12 6 12" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                    <path d="M8 18h16" stroke="white" stroke-width="1.5" stroke-linecap="round" opacity="0.7" />
                    <path d="M22 12l3-2-1 4" fill="white" opacity="0.9" />
                    <defs><linearGradient id="brandGrad" x1="0" y1="0" x2="32" y2="32"><stop stop-color="#0ea5e9"/><stop offset="1" stop-color="#6366f1"/></linearGradient></defs>
                </svg>
                <span class="brand-text">Flygio</span>
            </a>
            <nav class="site-nav">
                <NavLink href="/" Match="NavLinkMatch.All">Sök flyg</NavLink>
                <NavLink href="/flyg-till">Destinationer</NavLink>
                <NavLink href="/flygrutter">Flygrutter</NavLink>
                <NavLink href="/hotell">Hotell</NavLink>
                <NavLink href="/hyrbil">Hyrbil</NavLink>
                <NavLink href="/aktiviteter">Aktiviteter</NavLink>
                <NavLink href="/resor">Resor</NavLink>
                <NavLink href="/artiklar">Artiklar</NavLink>
                <AuthorizeView>
                    <Authorized>
                        <NavLink href="/admin/analytics">Analys</NavLink>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView>
                    <Authorized>
                        <NavLink href="/konto" class="nav-account">Mitt konto</NavLink>
                    </Authorized>
                    <NotAuthorized>
                        <NavLink href="/konto/logga-in" class="nav-login">Logga in</NavLink>
                    </NotAuthorized>
                </AuthorizeView>
            </nav>
        </div>
    </header>

    <main class="site-main">
        @Body
    </main>

    <footer class="site-footer">
        <div class="footer-inner">
            <div class="footer-grid">
                <div class="footer-about">
                    <div class="footer-brand">
                        <svg viewBox="0 0 32 32" width="24" height="24" fill="none"><circle cx="16" cy="16" r="15" fill="url(#fGrad)"/><path d="M10 20l6-12 6 12" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/><path d="M8 18h16" stroke="white" stroke-width="1.5" stroke-linecap="round" opacity="0.7"/><defs><linearGradient id="fGrad" x1="0" y1="0" x2="32" y2="32"><stop stop-color="#0ea5e9"/><stop offset="1" stop-color="#6366f1"/></linearGradient></defs></svg>
                        <span>Flygio</span>
                    </div>
                    <p>Sveriges smartaste flygsökmotor. Jämför priser, bevaka flygrutter och hitta de billigaste resorna.</p>
                </div>
                <div class="footer-links">
                    <h4>Tjänster</h4>
                    <a href="/flyg-till">Destinationer</a>
                    <a href="/flygrutter">Flygrutter</a>
                    <a href="/hotell">Hotell</a>
                    <a href="/hyrbil">Hyrbil</a>
                    <a href="/aktiviteter">Aktiviteter</a>
                </div>
                <div class="footer-links">
                    <h4>Resurser</h4>
                    <a href="/artiklar">Artiklar</a>
                    <a href="/resor">Reseplanerare</a>
                    <a href="/pro">Flygio Pro</a>
                    <a href="/nyhetsbrev">Nyhetsbrev</a>
                </div>
                <div class="footer-newsletter-col">
                    <NewsletterSignup />
                </div>
            </div>
            <div class="footer-bottom">
                <p class="footer-copy">&copy; @DateTime.Now.Year Flygio.se &mdash; Hitta billiga flyg från Sverige</p>
            </div>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ett oväntat fel har inträffat.
    <a href="." class="reload">Ladda om</a>
    <span class="dismiss">&#x1D5EB;</span>
</div>
