@inherits LayoutComponentBase

<div class="site">
    <header class="site-header">
        <div class="header-inner">
            <a href="/" class="site-brand">
                <span class="brand-icon">&#9992;</span>
                <span class="brand-text">Flygio</span>
            </a>
            <nav class="site-nav">
                <NavLink href="/" Match="NavLinkMatch.All">Sök flyg</NavLink>
                <NavLink href="/flyg-till">Destinationer</NavLink>
                <NavLink href="/artiklar">Artiklar</NavLink>
                <NavLink href="/admin/analytics">Analys</NavLink>
            </nav>
        </div>
    </header>

    <main class="site-main">
        @Body
    </main>

    <footer class="site-footer">
        <p>&copy; @DateTime.Now.Year Flygio.se &mdash; Hitta billiga flyg från Sverige</p>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&#x1D5EB;</span>
</div>
